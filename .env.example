# ==============================================================================
# AI Project Intelligence & Risk Advisor - Environment Configuration
# ==============================================================================

# Application Environment (production / development)
ENVIRONMENT=production

# Database Configuration
# Local SQLite fallback: sqlite:///./app.db
# PostgreSQL / pgvector (Recommended for production):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_project_db

# Security: Generate a secure 32-byte secret key for production:
# Command: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_secret_in_production_with_a_secure_random_key

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend URLs, or * for open access
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI & Embeddings Configuration
# Provider: openai (default). If no key provided, deterministic offline fallback hash embeddings will be used.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Document Processing & Knowledge Store
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Docker PostgreSQL Credentials (if deploying via docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=ai_project_db
